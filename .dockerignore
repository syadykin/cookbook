# Docker build context excludes
# Adjust as needed for your stack

# --- VCS ---
.git
.git/**
.github/
.gitlab/

# --- OS / General ---
.DS_Store
Thumbs.db

# --- Environment / Secrets ---
.env
.env.*
!.env.example
!.env.template
*.pem
*.key
*.crt
*.secret
*.config

# --- Logs ---
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
debug.log

# --- Editors / IDEs ---
.idea/
.vscode/
*.swp
*.swo

# --- JavaScript / Node ---
node_modules/
jspm_packages/
bower_components/

# Build outputs & caches
coverage/
.nyc_output/
dist/
build/
lib/
out/
tmp/
temp/
.cache/
.parcel-cache/
.eslintcache
.stylelintcache
.vite/
.svelte-kit/
.storybook-out/
storybook-static/
.next/
.nuxt/
.serverless/
.netlify/
.vercel/
remix.cache
functions/.build
.yarn-cache/
.pnpm-store/
.yarn/*
!.yarn/releases/
!.yarn/plugins/
!.yarn/sdks/
!.yarn/versions/

# Testing tools
__snapshots__/
playwright-report/
test-results/
.playwright-cache/
cypress/videos/
cypress/screenshots/

# TypeScript
*.tsbuildinfo

# --- Python ---
# Bytecode / caches
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
build/
dist/
downloads/
.eggs/
*.egg-info/
.installed.cfg
*.egg

# Virtual environments
.env/
.venv/
venv/
env/
ENV/

