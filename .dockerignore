.coverage
.coverage.*
htmlcov/
.tox/
.nox/
.pytest_cache/
.cache/

# Lint / type check
.mypy_cache/
.pyre/
.pytype/
.ruff_cache/

# Framework-specific
local_settings.py
instance/
db.sqlite3
*.sqlite3

# Jupyter / Spyder
.ipynb_checkpoints
.jupyter/
.spyderproject
.spyproject

